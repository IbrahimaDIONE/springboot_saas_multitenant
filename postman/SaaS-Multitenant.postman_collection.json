{
  "info": {
    "name": "BiblioUniv - Auth & Profil",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Authentification JWT, profil utilisateur, contrôle d'accès par rôle et gestion des établissements (BiblioUniv)."
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080"},
    {"key": "accessToken", "value": ""},
    {"key": "refreshToken", "value": ""},
    {"key": "categoryId", "value": ""},
    {"key": "productId", "value": ""},
    {"key": "etudiantId", "value": ""},
    {"key": "establishmentCode", "value": ""},
    {"key": "ouvrageId", "value": "20000000-0000-0000-0000-000000000003"},
    {"key": "empruntId", "value": ""}
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]
  },
  "item": [
    {
      "name": "Auth & Profil",
      "item": [
        {
          "name": "Login client-a (ADMIN_PLATEFORME)",
          "auth": {"type": "noauth"},
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"username\":\"client-a\",\"password\":\"password\"}"},
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Login admin plateforme', () => pm.response.to.have.status(200));",
                "const r = pm.response.json();",
                "pm.collectionVariables.set('accessToken', r.accessToken);",
                "pm.collectionVariables.set('refreshToken', r.refreshToken);"
              ]
            }
          }]
        },
        {
          "name": "Session /api/me (client-a)",
          "request": {"method": "GET", "url": "{{baseUrl}}/api/me"},
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Rôles admin plateforme', () => {",
                "  const r = pm.response.json();",
                "  pm.expect(r.roles).to.include('ADMIN_PLATEFORME');",
                "});"
              ]
