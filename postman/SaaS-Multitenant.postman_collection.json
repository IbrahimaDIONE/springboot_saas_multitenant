    {
      "name": "Gestion des étudiants",
      "item": [
        {
          "name": "Login client-b admin établissement",
          "auth": {"type": "noauth"},
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"username\":\"client-b\",\"password\":\"password\"}"},
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": ["pm.collectionVariables.set('accessToken', pm.response.json().accessToken);"]
            }
          }]
        },
        {
          "name": "Lister les étudiants du tenant B",
          "request": {"method": "GET", "url": "{{baseUrl}}/api/etudiants"},
          "event": [{
            "listen": "test",
            "script": {"exec": ["pm.test('Listing étudiants autorisé', () => pm.response.to.have.status(200));"]}
          }]
        },
        {
          "name": "Créer un étudiant inactif",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{studentUsername}}\",\"password\":\"password\",\"nom\":\"Demo\",\"prenom\":\"Etudiant\",\"email\":\"etudiant.demo@example.com\"}"
            },
            "url": "{{baseUrl}}/api/etudiants"
          },
          "event": [{
            "listen": "prerequest",
            "script": {"exec": ["pm.variables.set('studentUsername', 'etudiant-' + Date.now());"]}
          }, {
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Étudiant créé inactif', () => pm.response.to.have.status(201));",
                "const r = pm.response.json();",
                "pm.expect(r.enabled).to.eql(false);",
                "pm.collectionVariables.set('etudiantId', r.id);"
              ]
            }
          }]
        },
        {
          "name": "Activer l'étudiant",
          "request": {"method": "POST", "url": "{{baseUrl}}/api/etudiants/{{etudiantId}}/activation"},
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Étudiant activé', () => pm.response.to.have.status(200));",
                "pm.expect(pm.response.json().enabled).to.eql(true);"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "Gestion des établissements (ADMIN_PLATEFORME)",
      "item": [
        {
          "name": "Login plateforme",
          "auth": {"type": "noauth"},
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"username\":\"client-a\",\"password\":\"password\"}"},
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Login plateforme réussi', () => pm.response.to.have.status(200));",
                "const r = pm.response.json();",
                "pm.collectionVariables.set('accessToken', r.accessToken);",
                "pm.collectionVariables.set('refreshToken', r.refreshToken);"
              ]
            }
          }]
        },
        {
          "name": "Créer un établissement et son premier administrateur",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"code\":\"{{establishmentCode}}\",\"nom\":\"Etablissement Postman\",\"statut\":\"ACTIF\",\"parametres\":{\"dureeEmpruntJours\":\"14\"},\"administrateur\":{\"username\":\"{{establishmentCode}}-admin\",\"password\":\"password123\",\"nom\":\"Admin\",\"prenom\":\"Postman\",\"email\":\"postman@example.com\"}}"
            },
            "url": "{{baseUrl}}/api/etablissements"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {"exec": ["pm.collectionVariables.set('establishmentCode', 'postman-' + Date.now());"]}
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Etablissement créé', () => pm.response.to.have.status(201));",
                  "pm.expect(pm.response.json().code).to.eql(pm.collectionVariables.get('establishmentCode'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Lister les établissements",
          "request": {"method": "GET", "url": "{{baseUrl}}/api/etablissements"},
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Liste établissements accessible', () => pm.response.to.have.status(200));",
                "const codes = pm.response.json().map(e => e.code);",
                "pm.expect(codes).to.include(pm.collectionVariables.get('establishmentCode'));"
              ]
            }
          }]
        },
        {
          "name": "Modifier les paramètres d'un établissement",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"code\":\"{{establishmentCode}}\",\"nom\":\"Etablissement Postman modifié\",\"statut\":\"ACTIF\",\"parametres\":{\"dureeEmpruntJours\":\"21\"}}"
            },
            "url": "{{baseUrl}}/api/etablissements/{{establishmentCode}}"
          },
          "event": [{
            "listen": "test",
            "script": {"exec": ["pm.test('Etablissement modifié', () => pm.response.to.have.status(200));"]}
          }]
        },
        {
          "name": "Désactiver puis réactiver l'établissement",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/etablissements/{{establishmentCode}}/statut?valeur=INACTIF"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Etablissement désactivé', () => pm.response.to.have.status(200));",
                "pm.expect(pm.response.json().statut).to.eql('INACTIF');"
              ]
            }
          }]
        },
        {
          "name": "Réactiver l'établissement",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/etablissements/{{establishmentCode}}/statut?valeur=ACTIF"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Etablissement réactivé', () => pm.response.to.have.status(200));",
                "pm.expect(pm.response.json().statut).to.eql('ACTIF');"
              ]
            }
          }]
        },
        {
          "name": "Statistiques globales",
          "request": {"method": "GET", "url": "{{baseUrl}}/api/etablissements/statistiques"},
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Statistiques plateforme accessibles', () => pm.response.to.have.status(200));",
                "const r = pm.response.json();",
                "pm.expect(r.etablissements).to.be.above(0);",
                "pm.expect(r.etablissementsActifs).to.be.above(0);"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "Emprunt et lecture numérique (ETUDIANT)",
      "item": [
        {
          "name": "Login étudiant client-c",
          "auth": {"type": "noauth"},
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"username\":\"client-c\",\"password\":\"password\"}"},
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Login étudiant réussi', () => pm.response.to.have.status(200));",
                "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);"
              ]
            }
          }]
        },
        {
          "name": "Emprunter un ouvrage numérique",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"ouvrageId\":\"{{ouvrageId}}\"}"},
            "url": "{{baseUrl}}/api/emprunts"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Emprunt créé ou déjà actif', () => pm.expect([201, 409]).to.include(pm.response.code));",
                "const r = pm.response.json();",
                "if (pm.response.code === 201) {",
                "  pm.expect(r.ouvrageId).to.eql(pm.collectionVariables.get('ouvrageId'));",
                "  pm.expect(r.statut).to.eql('ACTIF');",
                "  pm.collectionVariables.set('empruntId', r.id);",
                "} else {",
                "  pm.expect(r.code).to.eql('BUSINESS_CONFLICT');",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Lister mes emprunts",
          "request": {"method": "GET", "url": "{{baseUrl}}/api/emprunts/mes-emprunts"},
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Mes emprunts accessibles', () => pm.response.to.have.status(200));",
                "const emprunts = pm.response.json();",
                "if (!pm.collectionVariables.get('empruntId') && emprunts.length) pm.collectionVariables.set('empruntId', emprunts[0].id);",
                "if (pm.collectionVariables.get('empruntId')) pm.expect(emprunts.map(e => e.id)).to.include(pm.collectionVariables.get('empruntId'));"
              ]
            }
          }]
        },
        {
          "name": "Consulter le détail de mon emprunt",
          "request": {"method": "GET", "url": "{{baseUrl}}/api/emprunts/{{empruntId}}"},
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Détail emprunt accessible', () => pm.response.to.have.status(200));",
                "pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('empruntId'));"
              ]
            }
          }]
        },
        {
          "name": "Lire l'ouvrage emprunté en ligne",
          "request": {"method": "GET", "url": "{{baseUrl}}/api/emprunts/{{empruntId}}/lire"},
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Lecture en ligne autorisée', () => pm.response.to.have.status(200));",
                "pm.expect(pm.response.json().empruntId).to.eql(pm.collectionVariables.get('empruntId'));",
                "pm.expect(pm.response.json().ouvrageId).to.eql(pm.collectionVariables.get('ouvrageId'));"
              ]
            }
          }]
        }
      ]
